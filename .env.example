# Copy to ".env" in this folder (or pass --env-file PATH). ".env" is gitignored.
# Values here are loaded before MOODLE_* is read; existing shell env vars are not overwritten.

# Required for scraping (full Cookie header value, e.g. MoodleSession=...)
MOODLE_SESSION_COOKIE=

# Optional: some Moodle installs expect a Referer
# MOODLE_REFERER=https://your-moodle.example/my/
